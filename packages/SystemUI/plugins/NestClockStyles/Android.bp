package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "NestClockStyles",
    srcs: ["java/**/*.kt"],
    resource_dirs: ["res"],
    manifest: "HalcyonManifest.xml",
    use_resource_processor: true,
    libs: [
        "SystemUIPluginLib",
    ],
    static_libs: [
        "SystemUISharedLib",
    ],
    certificate: "platform",
    optimize: {
        enabled: false,
    },
    platform_apis: true,
    system_ext_specific: true,
}
